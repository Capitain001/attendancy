#!/usr/bin/env sh
# pre-commit — service-api-index
# Garde-fou bornes (régime A) + régénération (régime B) + check cross-service.
# Voir apps/web/scripts/generate/api/ pour le générateur.

set -e

# Performance : skip total si aucun fichier apps/web/src/services/ n'est staged
if ! git diff --cached --name-only | grep -qE '^apps/web/src/services/'; then
  exit 0
fi

echo "generate-api: services touches detectes..."

# Extraire les service paths uniques (database/ ou actions/ staged)
SERVICES=$(git diff --cached --name-only | node -e "
const chunks = [];
process.stdin.on('data', d => chunks.push(d.toString()));
process.stdin.on('end', () => {
  const services = new Set();
  for (const line of chunks.join('').split('\n').filter(Boolean)) {
    const m = line.match(/^apps\/web\/src\/services\/(.+?)\/(database\/|database\.ts|actions\/|actions\.ts)/);
    if (m) services.add(m[1]);
  }
  process.stdout.write([...services].join('\n'));
});
")

if [ -z "$SERVICES" ]; then
  exit 0
fi

# ── a. Garde-fou bornes ──────────────────────────────────────────────────────
# Régime A (derived_at === "manual") : WARN si > 8 fns (non bloquant).
for svc in $SERVICES; do
  INDEX="apps/web/src/services/$svc/.api/index.json"
  if [ -f "$INDEX" ]; then
    INDEX="$INDEX" node -e '
      const fs = require("fs");
      let c = fs.readFileSync(process.env.INDEX, "utf8");
      if (c.charCodeAt(0) === 0xFEFF) c = c.slice(1);
      const idx = JSON.parse(c);
      if (idx.derived_at === "manual") {
        const n = Object.keys(idx.fns).length;
        if (n > 8) {
          process.stderr.write(
            "WARN [" + idx.service + "] regime manuel, " + n + " fns (indicatif > 8)." +
            " Envisager : npx tsx scripts/generate/api/api.ts " + idx.service + "\n"
          );
        }
      }
    '
  fi
done

# ── b. Régénération (régime B : derived_at = sha git) ────────────────────────
for svc in $SERVICES; do
  INDEX="apps/web/src/services/$svc/.api/index.json"
  if [ -f "$INDEX" ]; then
    IS_GEN=$(INDEX="$INDEX" node -e '
      const fs = require("fs");
      let c = fs.readFileSync(process.env.INDEX, "utf8");
      if (c.charCodeAt(0) === 0xFEFF) c = c.slice(1);
      const d = JSON.parse(c).derived_at;
      process.stdout.write(d !== "manual" && d !== "pending_generator" ? "yes" : "no");
    ')
    if [ "$IS_GEN" = "yes" ]; then
      echo "  -> Regeneration : $svc"
      (cd apps/web && npx tsx scripts/generate/api/api.ts "$svc") || exit 1
      git add "apps/web/src/services/$svc/.api/"
    fi
  fi
done

# ── c. Check global cross-service ────────────────────────────────────────────
# dead_reference -> bloque, unverified -> skip non bloquant
(cd apps/web && npx tsx scripts/generate/api/api.ts --check) || exit 1
