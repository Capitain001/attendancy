{
  "name": "attendancy",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,tauri -c cyan,magenta \"bun run dev:web\" \"bun --filter @attendancy/desktop run tauri:dev\"",
    "dev:web": "turbo dev --filter=@attendancy/web",
    "dev:desktop": "turbo dev --filter=@attendancy/desktop",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.0.0",
    "turbo": "^2.3.3"
  },
  "packageManager": "bun@1.3.14"
}
