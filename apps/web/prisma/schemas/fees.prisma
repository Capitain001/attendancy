// ─── Rattachements requis sur les modèles existants ─────────────────────────
//
// 1. Sur `Class` (academic.prisma) — lien vers la grille tarifaire appliquée
//    à cette classe (optionnel : SetNull, une classe peut exister sans
//    tarification encore définie) :
//
//    model Class {
//      ...
//      feeStructureId String?       @db.Uuid
//      feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
//    }
//
// 2. Sur `StudentEnrollment` (academic.prisma) — relation inverse vers sa
//    facture :
//
//    model StudentEnrollment {
//      ...
//      invoice Invoice?
//    }
//
// 3. Sur `Organization` (tenant.prisma) — back-relations (purge RGPD,
//    cohérent avec le reste du fichier) :
//
//    feeStructures FeeStructure[]
//    invoices      Invoice[]
//    payments      Payment[]
//    feeWaivers    FeeWaiver[]
//
// 4. Sur `User` (tenant.prisma) — relations inverses nommées (évite
//    l'ambiguïté Prisma vu qu'un User peut à la fois enregistrer un Payment
//    et approuver une FeeWaiver) :
//
//    recordedPayments Payment[]   @relation("PaymentRecordedBy")
//    approvedWaivers  FeeWaiver[] @relation("FeeWaiverApprovedBy")
