{
  "name": "@attendancy/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "tsc && vite build",
    "build:android": "tauri android build --apk --target aarch64 && node scripts/finalize-build-artifact.mjs android",
    "build:android:webview": "tauri android build --apk --target aarch64 --config src-tauri/webview/tauri.conf.json && node scripts/finalize-build-artifact.mjs webview",
    "build:desktop": "node scripts/build-desktop.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@attendancy/rpc": "workspace:*",
    "@attendancy/ui": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "idb-keyval": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
