{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/generated/prisma/*": [
        "../../packages/db/src/generated/*"
      ],
      "@/*": [
        "../../apps/web/src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}